<resources>
    <style name="ModernButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:backgroundTint">#E0E0E0</item>
        <item name="android:textColor">#222</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:elevation">4dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="ModernButtonPrimary" parent="ModernButton">
        <item name="android:backgroundTint">#2196F3</item>
        <item name="android:textColor">#fff</item>
    </style>
    <style name="ModernButtonRed" parent="ModernButton">
        <item name="android:backgroundTint">#F44336</item>
        <item name="android:textColor">#fff</item>
    </style>
    <style name="ModernButtonGreen" parent="ModernButton">
        <item name="android:backgroundTint">#4CAF50</item>
        <item name="android:textColor">#fff</item>
    </style>
    <style name="ModernButtonBlue" parent="ModernButton">
        <item name="android:backgroundTint">#03A9F4</item>
        <item name="android:textColor">#fff</item>
    </style>
    <style name="ModernSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:textColor">#222</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
